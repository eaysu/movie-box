# --- Copy this file to ".env" and fill in your keys ---

# TMDb API key — get one free at https://www.themoviedb.org/settings/api
# Without it, the enrichment step is skipped (recommendations still work,
# but only on title text, which is weaker).
TMDB_API_KEY=

# OpenAI API key — https://platform.openai.com/api-keys
# Without it, the LLM ranking step falls back to plain similarity ordering.
OPENAI_API_KEY=

# Which model the LLM ranking layer uses.
OPENAI_MODEL=gpt-5-mini

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# URL: Settings > API > Project URL
# KEY: Settings > API > service_role secret key (not the anon key)
# Without these, the app uses a local SQLite cache instead.
SUPABASE_URL=
SUPABASE_KEY=

# Embedding backend: "tfidf" (lightweight, no extra install, good for a
# quick start) or "sentence-transformers" (semantic, much better quality,
# needs `pip install sentence-transformers`).
EMBEDDING_PROVIDER=tfidf

# sentence-transformers model name (only used when provider is set above).
ST_MODEL=all-MiniLM-L6-v2

# How many candidate films the similarity step hands to the LLM.
CANDIDATE_POOL_SIZE=25

# How many final recommendations to return.
NUM_RECOMMENDATIONS=5

# ScraperAPI key — https://www.scraperapi.com/
# When set, all Letterboxd requests are routed through ScraperAPI's residential
# proxies, bypassing Cloudflare IP blocks on cloud hosting (Render etc.).
SCRAPERAPI_KEY=

# Polite delay (seconds) between Letterboxd page requests.
SCRAPE_DELAY=1.0

# Where the prebuilt catalog and caches live.
DATA_DIR=data
